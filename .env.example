# Runtime connection: use the restricted sat_app Neon role in production.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Migration connection: use the Neon owner role. Never expose this to the browser.
DATABASE_ADMIN_URL=postgresql://owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# The publishable key is intentionally exposed to the browser. The secret key
# stays server-side and lets Clerk's SDK retrieve rotating JWKS verification keys.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Required only when using Clerk's production Frontend API proxy. Scope this
# value to Vercel Production, never Preview or Development.
# CLERK_PROXY_URL=https://your-project.vercel.app/__clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Comma-separated exact origins allowed to create authenticated requests.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5174,http://localhost:5174,https://your-production-domain.example

# Clerk user IDs allowed to refresh the shared College Board question catalog.
ADMIN_USER_IDS=user_replace_with_your_clerk_user_id
